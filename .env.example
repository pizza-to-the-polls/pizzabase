# Clip Factory — render
RENDER_DAILY_BUDGET=50
RENDER_FONT_FILE=/opt/fonts/DejaVuSans-Bold.ttf
FFMPEG_PATH=/opt/bin/ffmpeg

# Clip Factory — Slack kit distribution (DIST-001). Zapier catch hook URL;
# the Zap on the other end routes the kit payload to the #clip-kit channel.
# Leave unset locally — the notifier is a no-op when it's empty.
ZAP_NEW_CLIP=https://hooks.zapier.com/hooks/catch/...

# Twilio — auth token for X-Twilio-Signature verification on POST /twilio/inbound
TWILIO_AUTH_TOKEN=
# Slack — incoming webhook for MMS media notifications (unset = feature disabled)
MMS_SLACK_WEBHOOK_URL=
# Days after pizza delivery during which MMS replies are matched to a report
MMS_MATCH_WINDOW_DAYS=30
