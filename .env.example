# Clip Factory — short links (CLIP-003)
# Short domain for end-card QR payloads — pending registration. Must match
# the /l/:slug redirect route.
SHORT_URL_BASE=https://polls.pizza/l
# Donation landing page each clip's short link points at.
DONATE_LANDING_URL=https://www.polls.pizza/donate

# Clip Factory — render
RENDER_DAILY_BUDGET=50
RENDER_FONT_FILE=/opt/fonts/DejaVuSans-Bold.ttf
FFMPEG_PATH=/opt/bin/ffmpeg

# Clip Factory — Slack kit distribution (DIST-001). Slack incoming webhook
# URL; leave unset locally — the notifier is a no-op when it's empty.
CLIP_KIT_SLACK_WEBHOOK=https://hooks.slack.com/services/...
