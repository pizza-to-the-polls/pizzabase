# Clip Factory — render
RENDER_DAILY_BUDGET=50
RENDER_FONT_FILE=/opt/fonts/DejaVuSans-Bold.ttf
FFMPEG_PATH=/opt/bin/ffmpeg

# Clip Factory — Slack kit distribution (DIST-001). Zapier catch hook URL;
# the Zap on the other end routes the kit payload to the #clip-kit channel.
# Leave unset locally — the notifier is a no-op when it's empty.
ZAP_NEW_CLIP=https://hooks.zapier.com/hooks/catch/...

# Twilio — auth token for X-Twilio-Signature verification on POST /twilio/inbound
TWILIO_AUTH_TOKEN=
# MMS reply media — routed through a Zapier catch hook; the Zap on the
# other end posts to the internal channel. Leave unset locally — the
# notifier is a no-op when it's empty.
ZAP_NEW_MMS_UPLOAD=https://hooks.zapier.com/hooks/catch/...
# Days after pizza delivery during which MMS replies are matched to a report
MMS_MATCH_WINDOW_DAYS=30
# Extra hosts the inbound MMS webhook may fetch MediaUrls from (comma-
# separated). Staging-only test convenience: leave unset (Twilio-only) in prod.
TWILIO_MEDIA_EXTRA_HOSTS=
# Shared token for the trusted-relay path on POST /twilio/inbound (Zapier
# forwards non-Twilio multimedia messages with X-PTP-Inbound-Token or
# Authorization: Bearer). Unset = relay disabled.
INBOUND_WEBHOOK_TOKEN=
