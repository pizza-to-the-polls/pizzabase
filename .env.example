# Clip Factory — render
RENDER_DAILY_BUDGET=50
RENDER_FONT_FILE=/opt/fonts/DejaVuSans-Bold.ttf
FFMPEG_PATH=/opt/bin/ffmpeg

# Clip Factory — Slack kit distribution (DIST-001). Zapier catch hook URL;
# the workflow on the other end (durable workflow "migrated-new-clip-hook",
# managed via Zapier MCP) posts the kit payload to #feed-clips with per-photo
# threaded replies. Leave unset locally — the notifier is a no-op when it's empty.
ZAP_NEW_CLIP=https://hooks.zapier.com/hooks/catch/...

# Twilio — auth token for X-Twilio-Signature verification on POST /twilio/inbound
TWILIO_AUTH_TOKEN=
# Account SID (Twilio Console → Account Info) — used with the auth token to
# fetch media by MessageSid when the relay forwards only the SID. Leave unset
# = SID fetch disabled.
TWILIO_ACCOUNT_SID=
# MMS reply media — routed through a Zapier catch hook; the Zap on the
# other end posts to the internal channel. Leave unset locally — the
# notifier is a no-op when it's empty.
ZAP_NEW_MMS_UPLOAD=https://hooks.zapier.com/hooks/catch/...
# Days after pizza delivery during which MMS replies are matched to a report
MMS_MATCH_WINDOW_DAYS=30
# Extra hosts the inbound MMS webhook may fetch MediaUrls from (comma-
# separated). Staging-only test convenience: leave unset (Twilio-only) in prod.
TWILIO_MEDIA_EXTRA_HOSTS=
# Shared token for the trusted-relay path on POST /twilio/inbound (Zapier
# forwards non-Twilio multimedia messages with X-PTP-Inbound-Token or
# Authorization: Bearer). Unset = relay disabled.
INBOUND_WEBHOOK_TOKEN=

# ZAP_SKIP_REPORT / ZAP_CANCEL_ORDER_REPORT now point at Zapier durable
# workflows (migrated-zap-skip-report, migrated-zap-cancel-order-report,
# managed via Zapier MCP). Secrets were swapped 2026-10-18; deploys pick
# them up from GitHub Actions secrets.

# ZAP_ORDER_REPORT also now points at the durable workflow
# migrated-zap-order-report (Zapier MCP), swapped 2026-10-20.

# Social posting target (#213): "live" (default) posts to Bluesky/Twitter/
# Threads as usual. Set to "slack" to route the rendered post (text + media
# URLs + would-be platforms) to a Slack incoming webhook instead — staging
# shim so staging deploys without live social credentials stay observable.
# Anything other than "slack" behaves as "live".
SOCIAL_POST_TARGET=live
# Slack incoming webhook URL — required when SOCIAL_POST_TARGET=slack
# (store the staging secret as STAGING_SLACK_WEBHOOK_URL in GitHub).
# Delivery is fire-and-forget: failures are logged and never block the
# order response. Leave unset locally to disable Slack delivery.
SLACK_WEBHOOK_URL=
